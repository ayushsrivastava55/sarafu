{
  "name": "sarafu",
  "version": "0.1.0",
  "description": "Sarafu — AI-powered cross-border remittance agent on Celo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "contracts:compile": "turbo run compile --filter=hardhat",
    "contracts:test": "turbo run test --filter=hardhat",
    "contracts:deploy": "turbo run deploy --filter=hardhat",
    "contracts:deploy:celo-sepolia": "turbo run deploy:celo-sepolia --filter=hardhat",
    "contracts:deploy:celo": "turbo run deploy:celo --filter=hardhat",
    "contracts:deploy:status-sepolia": "turbo run deploy:status-sepolia --filter=hardhat",
    "agent:dev": "pnpm --filter @sarafu/agent dev",
    "agent:build": "pnpm --filter @sarafu/agent build",
    "agent:start": "pnpm --filter @sarafu/agent start",
    "web:dev": "pnpm --filter web dev"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "turbo": "^1.10.16",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
